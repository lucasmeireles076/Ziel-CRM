# API / database
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=crm
DATABASE_URL=postgresql+asyncpg://crm:change-this-database-password@postgres:5432/crm
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000

# Evolution API / WhatsApp. Change this key before exposing the services.
EVOLUTION_API_KEY=change-this-evolution-key
EVOLUTION_INSTANCE=crm
EVOLUTION_API_URL=http://evolution-api:8080
WHATSAPP_WEBHOOK_URL=http://api:8000/api/v1/whatsapp/webhook

# Ollama running on the host (or point to your Ollama/vLLM OpenAI-compatible service)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Marketplaces remain disabled until OAuth/LWA credentials and adapters are implemented.
MELI_ENABLED=false
AMAZON_ENABLED=false

# Reactivation
REACTIVATION_DAYS=15
REACTIVATION_MESSAGE=Oi {name}! Faz um tempinho desde nossa última conversa. Posso ajudar você com alguma coisa?
